# Copy to .env and change every value before any deployment. .env is gitignored.

# Database
DB_NAME=nirman
DB_USER=nirman
DB_PASSWORD=nirman_dev_password
DB_PORT=5432

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_48_byte_base64_secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Object storage
MINIO_ROOT_USER=nirman_minio
MINIO_ROOT_PASSWORD=nirman_minio_dev_password
MINIO_BUCKET=nirman-files

# App
SPRING_PROFILE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
